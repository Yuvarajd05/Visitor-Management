# PostgreSQL connection
# Option A: Prisma Dev (run `npx prisma dev` first, then use the TCP URL + sslmode=disable)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:51214/template1?schema=public&sslmode=disable"

# Option B: Local / production PostgreSQL
# DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/invenger_vms?schema=public"

# Required — use a long random string in production
JWT_SECRET="change-this-to-a-secure-random-string"
JWT_EXPIRES_IN="750m"
JWT_REMEMBER_ME_EXPIRES_IN="7d"

# Seed users (used only by `npm run db:seed`) — set your own values locally
SEED_ADMIN_EMAIL="admin"
SEED_ADMIN_PASSWORD="123"
SEED_SECURITY_EMAIL="security"
SEED_SECURITY_PASSWORD="123"

# Application
NEXT_PUBLIC_APP_NAME="Invenger Visitor Management System"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# SMTP (optional — prefer Admin → Settings in the app)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
