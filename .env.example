# PostgreSQL connection
# Option A: Prisma Dev (run `npx prisma dev -d` first, then use the TCP URL + sslmode=disable)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:51214/template1?schema=public&sslmode=disable"

# Option B: Local PostgreSQL (replace USER, PASSWORD, PORT, and DB name)
# DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/invenger_vms?schema=public"
JWT_SECRET="change-this-to-a-secure-random-string"
# Reception desk — 1 week session by default
JWT_EXPIRES_IN="7d"
JWT_REMEMBER_ME_EXPIRES_IN="7d"

# Application
NEXT_PUBLIC_APP_NAME="Invenger Visitor Management System"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# SMTP email delivery (password reset + visitor notifications)
# Preferred: configure in Admin → Settings → Email / SMTP
# Fallback: set these env vars
# Local/dev without SMTP → Ethereal test inbox + preview URL in terminal
#
# Gmail example (use an App Password, not your normal password):
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-16-char-app-password"
# SMTP_FROM="Invenger VMS <your-email@gmail.com>"
#
# Microsoft 365 example:
# SMTP_HOST="smtp.office365.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="noreply@yourcompany.com"
# SMTP_PASS="your-password"
# SMTP_FROM="Invenger VMS <noreply@yourcompany.com>"
