{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@/backend/*": ["./backend/*"],
      "@/frontend/*": ["./frontend/*"],
      "@/components/*": ["./frontend/components/*"],
      "@/features/*": ["./frontend/features/*"],
      "@/hooks/*": ["./frontend/hooks/*"],
      "@/lib/*": ["./backend/lib/*"],
      "@/services/*": ["./backend/services/*"],
      "@/types/*": ["./backend/types/*"],
      "@/utils/*": ["./backend/utils/*"],
      "@/middleware/*": ["./backend/middleware/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
